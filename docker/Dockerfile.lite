# syntax=docker/dockerfile:1
# WeKnora Lite 单二进制镜像（内置 SQLite，零外部依赖：无 PostgreSQL / Redis / MQ）
# 与 .github/workflows/release-lite.yml 的构建方式保持一致：
#   EDITION=lite + go build -tags "sqlite_fts5" + CGO_ENABLED=1

# ── 1. 前端 ─────────────────────────────────────────────
FROM node:22-bookworm AS frontend
WORKDIR /src
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build          # 产物在 /src/dist

# ── 2. Go 二进制（CGO 必须开，sqlite_fts5 依赖）───────────
FROM golang:1.26-bookworm AS builder
RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential ca-certificates libsqlite3-dev pkg-config \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY go.mod go.sum ./
# go.mod 里有 replace github.com/firecrawl/anydoc/go => ./third_party/anydoc-go
# 本地 replace 目标必须先存在，否则 go mod download 会报 no such file
COPY third_party ./third_party
RUN go mod download
COPY . .
COPY --from=frontend /src/dist ./web

ENV CGO_ENABLED=1 \
    EDITION=lite \
    CGO_CFLAGS="-Wno-deprecated-declarations"

# get_version.sh 会注入 handler.Edition=$EDITION；缺了它前端不会被托管、Lite 专属逻辑也不生效
RUN go build -tags "sqlite_fts5" -ldflags="-w -s $(bash ./scripts/get_version.sh ldflags)" -o /out/WeKnora-lite ./cmd/server

# 组装运行时目录（config / migrations 存在才拷，避免目录缺失导致构建失败）
RUN mkdir -p /out/pkg \
 && cp /out/WeKnora-lite /out/pkg/ \
 && cp -r web /out/pkg/web \
 && cp -r "$(go list -m -f '{{.Dir}}' github.com/yanyiwu/gojieba)/deps/cppjieba/dict" /out/pkg/dict \
 && { [ -d config ] && cp -r config /out/pkg/config || true; } \
 && { [ -d migrations/sqlite ] && mkdir -p /out/pkg/migrations/sqlite && cp -r migrations/sqlite/. /out/pkg/migrations/sqlite/ || true; } \
 && { [ -f .env.lite.example ] && cp .env.lite.example /out/pkg/ || true; }

# ── 3. 运行时 ───────────────────────────────────────────
FROM debian:bookworm-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates tzdata libsqlite3-0 \
 && rm -rf /var/lib/apt/lists/* \
 && useradd -m -u 10001 weknora

WORKDIR /app
COPY --from=builder --chown=weknora:weknora /out/pkg /app
RUN mkdir -p /app/data && chown -R weknora:weknora /app

USER weknora
ENV TZ=Asia/Shanghai \
    PORT=8080 \
    JIEBA_DICT_DIR=/app/dict

# Lite 默认读程序目录下的 .env.lite；挂载 /app/data 持久化 SQLite
VOLUME ["/app/data"]
EXPOSE 8080

ENTRYPOINT ["/app/WeKnora-lite"]
